{
  "name": "Commune-Plus-BackOffice",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotenv -e .env -- node --max-old-space-size=3072 node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "dotenv -e .env.local -- nuxt dev",
    "preview": "dotenv -e .env -- nuxt preview",
    "start": "dotenv -e .env -- node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/simple-icons": "^1.2.63",
    "@nuxt/image": "1.0.0-rc.3",
    "@nuxt/ui": "^4.3.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "@supabase/supabase-js": "^2.89.0",
    "@types/leaflet": "^1.9.21",
    "@unovis/ts": "^1.6.2",
    "@unovis/vue": "^1.6.2",
    "@vueuse/nuxt": "^14.1.0",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "nuxt": "^4.2.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.12.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.1"
  },
  "packageManager": "pnpm@10.26.1"
}
