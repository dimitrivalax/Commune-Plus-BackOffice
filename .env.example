# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Firebase Admin (serveur)
# Option recommandée: JSON complet sur une seule ligne
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optionnel: base Firestore cible (par défaut "(default)")
FIREBASE_DATABASE_NAME=
# Fallback compatible pour FCM si nécessaire
FCM_SERVICE_ACCOUNT_JSON=
# Ou chemin vers le fichier JSON (alternative à FCM_SERVICE_ACCOUNT_JSON)
FCM_SERVICE_ACCOUNT_PATH=

# Firebase Web (client BackOffice)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# URL publique du BackOffice (liens e-mail, redirections)
APP_URL=https://backoffice.commune-plus.fr

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Resend (emails transactionnels)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@commune-plus.fr

# PostHog Analytics Configuration
# Get your API key from https://app.posthog.com/project/settings
POSTHOG_API_KEY=your_posthog_api_key
# Optional: Custom PostHog host (defaults to https://app.posthog.com)
POSTHOG_HOST=https://app.posthog.com

